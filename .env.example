# ─── Database ─────────────────────────────────────────────────────────────────
# Railway sets this automatically when you add a Postgres plugin.
# Local dev: postgresql://postgres:password@localhost:5432/gateview
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require"

# ─── Admin portal ─────────────────────────────────────────────────────────────
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-before-going-live"

# ─── Optional: live flight data ───────────────────────────────────────────────
# Get a free key at https://aviationstack.com (500 req/month free)
AVIATIONSTACK_API_KEY=""

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="GateView"
NEXT_PUBLIC_AIRPORT_NAME="Jomo Kenyatta International Airport"
NEXT_PUBLIC_AIRPORT_CODE="JKIA"
NODE_ENV="production"
