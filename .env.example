# .env.example — copy to .env.local and fill in values

# PostgreSQL connection string
# Local:   postgresql://postgres:password@localhost:5432/gateview
# Supabase: postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
# Neon:    postgresql://[user]:[password]@[endpoint].neon.tech/gateview?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/gateview"

# Optional: AviationStack API key for live flight data
# Get one free at https://aviationstack.com
AVIATIONSTACK_API_KEY=""

# Optional: App URL (used for absolute links in emails etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
