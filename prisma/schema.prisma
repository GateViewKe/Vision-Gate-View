// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Airport {
  id        String     @id @default(cuid())
  code      String     @unique // e.g. "JKIA"
  name      String
  city      String
  country   String
  terminals Terminal[]
  beacons   Beacon[]
  createdAt DateTime   @default(now())
}

model Terminal {
  id        String   @id @default(cuid())
  airportId String
  airport   Airport  @relation(fields: [airportId], references: [id], onDelete: Cascade)
  code      String   // e.g. "T1A". Required because API routes search by terminal code.
  name      String   // e.g. "Terminal 1A"
  floor     Int      @default(0)
  floorPlan Json
  pois      POI[]
  beacons   Beacon[]
  tickets   Ticket[]

  @@unique([airportId, code])
}

model Ticket {
  id                 String    @id @default(cuid())
  ticketNumber       String    @unique
  passengerName      String
  flightNumber       String
  airline            String
  airlineLogo        String?
  origin             String
  destination        String
  gate               String
  floor              Int       @default(1)
  seat               String
  seatClass          String    @default("Economy") // Economy | Business | First
  scheduledDeparture String    // "HH:MM" local time
  boardingTime       String    // "HH:MM" local time
  status             String    @default("ON_TIME") // ON_TIME | BOARDING | DELAYED | DEPARTED | CANCELLED
  delayMinutes       Int?
  terminalId         String?
  terminal           Terminal? @relation(fields: [terminalId], references: [id], onDelete: SetNull)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([ticketNumber])
  @@index([flightNumber])
  @@index([gate])
}

model POI {
  id          String   @id @default(cuid())
  terminalId  String
  terminal    Terminal @relation(fields: [terminalId], references: [id], onDelete: Cascade)
  name        String
  type        POIType
  x           Float
  y           Float
  description String?
  gateCode    String?
  flightId    String?
  openHours   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Beacon {
  id         String   @id @default(cuid())
  airportId  String
  airport    Airport  @relation(fields: [airportId], references: [id], onDelete: Cascade)
  terminalId String
  terminal   Terminal @relation(fields: [terminalId], references: [id], onDelete: Cascade)
  macAddress String   @unique
  x          Float
  y          Float
  floor      Int      @default(0)
  txPower    Int      @default(-59)
  createdAt  DateTime @default(now())
}

model PositionLog {
  id        String   @id @default(cuid())
  sessionId String
  x         Float
  y         Float
  floor     Int      @default(0)
  accuracy  Float
  method    String   @default("wifi") // "wifi" | "ble" | "gps" | "simulated"
  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([createdAt])
}

enum POIType {
  GATE
  SHOP
  DINING
  LOUNGE
  RESTROOM
  SERVICE
  SECURITY
  CHECKIN
}
