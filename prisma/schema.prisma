// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Airport {
  id        String   @id @default(cuid())
  code      String   @unique   // e.g. "JKIA"
  name      String
  city      String
  country   String
  terminals Terminal[]
  beacons   Beacon[]
  createdAt DateTime @default(now())
}

model Terminal {
  id        String  @id @default(cuid())
  airportId String
  airport   Airport @relation(fields: [airportId], references: [id])
  name      String                       // e.g. "Terminal 1A"
  floor     Int     @default(0)
  floorPlan Json                         // GeoJSON-style wall/corridor polygons
  pois      POI[]
  beacons   Beacon[]
}

model POI {
  id          String   @id @default(cuid())
  terminalId  String
  terminal    Terminal @relation(fields: [terminalId], references: [id])
  name        String
  type        POIType
  x           Float                      // canvas X coordinate
  y           Float                      // canvas Y coordinate
  description String?
  gateCode    String?                    // e.g. "B12"
  flightId    String?
  openHours   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Beacon {
  id         String   @id @default(cuid())
  airportId  String
  airport    Airport  @relation(fields: [airportId], references: [id])
  terminalId String
  terminal   Terminal @relation(fields: [terminalId], references: [id])
  macAddress String   @unique
  x          Float
  y          Float
  floor      Int      @default(0)
  txPower    Int      @default(-59)      // RSSI at 1m in dBm
  createdAt  DateTime @default(now())
}

model PositionLog {
  id        String   @id @default(cuid())
  sessionId String
  x         Float
  y         Float
  floor     Int      @default(0)
  accuracy  Float
  method    String   @default("wifi")   // "wifi" | "ble" | "gps"
  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([createdAt])
}

enum POIType {
  GATE
  SHOP
  DINING
  LOUNGE
  RESTROOM
  SERVICE
  SECURITY
  CHECKIN
}
